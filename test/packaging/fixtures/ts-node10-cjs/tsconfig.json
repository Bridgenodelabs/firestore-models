{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],

    // The exact combination that fails against 0.2.0. `node10` ignores the
    // `exports` map entirely, so it reaches the package only through
    // `main`/`types` and the generated subpath stubs.
    "module": "commonjs",
    "moduleResolution": "node10",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["src"]
}
