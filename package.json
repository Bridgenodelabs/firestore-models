{
  "name": "@bridgenodelabs/firestore-models",
  "version": "0.2.1",
  "description": "TypeScript types and utilities for Firestore, usable in both browser and Node.js environments",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.mts",
        "default": "./dist/core/index.mjs"
      },
      "require": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      }
    },
    "./time": {
      "import": {
        "types": "./dist/time/index.d.mts",
        "default": "./dist/time/index.mjs"
      },
      "require": {
        "types": "./dist/time/index.d.ts",
        "default": "./dist/time/index.js"
      }
    },
    "./adapters/firebase-client": {
      "import": {
        "types": "./dist/adapters/firebase-client/index.d.mts",
        "default": "./dist/adapters/firebase-client/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/firebase-client/index.d.ts",
        "default": "./dist/adapters/firebase-client/index.js"
      }
    },
    "./adapters/firebase-admin": {
      "import": {
        "types": "./dist/adapters/firebase-admin/index.d.mts",
        "default": "./dist/adapters/firebase-admin/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/firebase-admin/index.d.ts",
        "default": "./dist/adapters/firebase-admin/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "time": [
        "./dist/time/index.d.ts"
      ],
      "adapters/firebase-client": [
        "./dist/adapters/firebase-client/index.d.ts"
      ],
      "adapters/firebase-admin": [
        "./dist/adapters/firebase-admin/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "agents",
    "core",
    "time",
    "adapters",
    "react"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-build-output.mjs",
    "build": "tsup",
    "postbuild": "node scripts/generate-node10-stubs.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/verify-package-contents.mjs",
    "check:publint": "publint --strict",
    "check:attw": "attw --pack .",
    "test:packaging": "node scripts/verify-packaging.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check && pnpm run check:publint && pnpm run check:attw && pnpm run test:packaging",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build && pnpm run pack:check && pnpm run check:publint && pnpm run check:attw",
    "prepare": "husky"
  },
  "keywords": [
    "firestore",
    "typescript",
    "firebase",
    "types"
  ],
  "author": "Todd Warren <todd@warrenfamily.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridgenodelabs/firestore-models.git"
  },
  "homepage": "https://github.com/bridgenodelabs/firestore-models",
  "bugs": {
    "url": "https://github.com/bridgenodelabs/firestore-models/issues"
  },
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "firebase": ">=10.0.0",
    "firebase-admin": ">=12.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
