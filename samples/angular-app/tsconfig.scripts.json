{
  // Type-check for scripts/ (the live-verification runner), which is Node code
  // rather than browser code and so needs @types/node. Kept separate from the
  // app so Node globals never leak into the Angular sources. No `outDir`, for
  // the same TS6059 reason as tsconfig.typecheck.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "src/environments/**/*.ts", "src/models/**/*.ts"]
}
